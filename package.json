{
  "name": "cd-connect",
  "version": "0.4.1",
  "description": "MCP stage task bridge for the native DSH desktop Host",
  "private": true,
  "type": "module",
  "engines": { "node": ">=22.19.0", "dsh": "0.2.1-rc.2" },
  "exports": { ".": "./src/plugin.js", "./cordis.patch.yml": "./cordis.patch.yml" },
  "bin": { "cd-connect-mcp": "./src/stdio.js" },
  "files": ["src/", "scripts/", "test/", "docs/", "cordis.patch.yml", "README.md", "README.en.md"],
  "dsh": { "bundle": { "patch": "./cordis.patch.yml" } },
  "scripts": { "test": "node --test test/*.test.js", "check": "node scripts/check.js", "health": "node scripts/health.js", "verify:native": "node scripts/verify-native.js" },
  "dependencies": { "@modelcontextprotocol/sdk": "1.32.1", "zod": "^4.4.3" }
}
